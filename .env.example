ENVIRONMENT=development

API_PREFIX=/api/v1

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/brand_intelligence

REDIS_URL=redis://redis:6379/0

POSTGRES_USER=postgres

POSTGRES_PASSWORD=postgres

POSTGRES_DB=brand_intelligence

# Development only (>= 32 chars). Production MUST set a strong unique secret.

JWT_SECRET=change-me-in-development-only!!!

JWT_EXPIRE_MINUTES=60

COOKIE_NAME=ai_brand_access_token

# Production requires COOKIE_SECURE=true (HTTPS).

COOKIE_SECURE=false

COOKIE_SAMESITE=lax

# Explicit origins only. Never use *.

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

CRAWLER_MAX_PAGES=20

CRAWLER_MAX_DEPTH=3

CRAWLER_REQUEST_TIMEOUT_SECONDS=10

CRAWLER_DELAY_SECONDS=0.1

CRAWLER_MAX_RESPONSE_BYTES=5000000

CRAWLER_USER_AGENT=AI-Brand-Intelligence-Crawler/1.0

CRAWLER_MAX_REDIRECTS=5

SEO_TITLE_MAX_LENGTH=60

SEO_TITLE_MIN_LENGTH=10

SEO_META_DESCRIPTION_MAX_LENGTH=160

SEO_META_DESCRIPTION_MIN_LENGTH=50

SEO_LOW_WORD_COUNT=300

SEO_SLOW_RESPONSE_MS=2000

AI_PROVIDER=mock

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4o-mini

OPENAI_TIMEOUT_SECONDS=30

AI_QUERY_MAX_PER_AUDIT=18

RECOMMENDATIONS_MAX_PER_AUDIT=20

REPORTS_DIR=./data/reports



# --- Production placeholders (see docs/deployment.md) ---

# Copy to .env.prod for docker-compose.prod.yml. Never commit real secrets.

# ENVIRONMENT=production

# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# COOKIE_SECURE=true

# COOKIE_SAMESITE=lax

# DATABASE_URL=postgresql://brand_app:CHANGE_ME_DB_PASSWORD@postgres:5432/brand_intelligence

# POSTGRES_USER=brand_app

# POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# POSTGRES_DB=brand_intelligence

# CORS_ORIGINS=https://app.example.com

# REPORTS_DIR=/data/reports

# AI_PROVIDER=openai

# OPENAI_API_KEY=sk-replace-me

# OPENAI_MODEL=gpt-4o-mini

# OPENAI_TIMEOUT_SECONDS=30

# RUN_MIGRATIONS_ON_START=false

# WEB_CONCURRENCY=2

# FRONTEND_PUBLISH_PORT=8080


